# Jerk Vest app — environment variables.
# Everything here is OPTIONAL. With none of these set the app runs fine; the
# analytics layer simply no-ops and the background uses generated motion.
#
# These are EXPO_PUBLIC_* on purpose: they are safe to ship to the client.
# (The Supabase anon key can only INSERT analytics events — never read them.)

# --- Analytics (Supabase) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL of the token-gated edge function that powers the /admin dashboard.
EXPO_PUBLIC_ANALYTICS_FN_URL=

# --- Optional menu polish ---
# A looping, muted background video for the menu. Leave empty to use the
# built-in animated background instead.
EXPO_PUBLIC_BG_VIDEO_URL=
# A menu audio loop. Audio stays OFF by default — the speaker toggle turns it on.
EXPO_PUBLIC_MENU_AUDIO_URL=
